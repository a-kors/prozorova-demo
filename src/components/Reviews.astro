---
import { master, reviews } from '../data/master';
---

<section id="reviews" class="rv">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Отзывы</span>
      <h2>«После первого разговора мне стало гораздо&nbsp;легче».</h2>
      <p>
        Отзывы клиентов из&nbsp;профиля Анастасии на&nbsp;b17.ru, как есть,
        с&nbsp;её ответами.
      </p>
    </header>

    <div class="rv__cols">
      {reviews.map((r, i) => (
        <figure class="rc rc--text" data-reveal data-reveal-delay={Math.min(i * 90, 300)}>
          <span class="rc__q" aria-hidden="true">«</span>
          <blockquote>{r.text}</blockquote>
          <figcaption>
            <span class="rc__name">{r.name}</span>
            <span class="rc__date">{r.date}</span>
          </figcaption>
          <p class="rc__reply"><span>Ответ Анастасии:</span> {r.reply}</p>
        </figure>
      ))}
    </div>

    <div class="rv__footer">
      <a class="btn btn-secondary" href={master.b17} target="_blank" rel="noopener">
        <span>Все отзывы на&nbsp;b17</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .rv {
    background: var(--bg-soft);
  }
  .rv__wall {
    position: relative;
    max-height: 1800px;
    overflow: hidden;
    transition: max-height 0.6s ease;
    margin-bottom: 32px;
  }
  .rv__wall.is-open {
    max-height: none;
  }
  .rv__wall.is-open .rv__fade {
    display: none;
  }
  .rv__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 220px;
    background: linear-gradient(to bottom, rgba(243, 237, 225, 0), var(--bg-soft) 92%);
    pointer-events: none;
  }
  .rv__cols {
    columns: 3;
    column-gap: 16px;
  }
  .rc {
    display: block;
    break-inside: avoid;
    margin: 0 0 16px;
    border-radius: 14px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(31, 25, 21, 0.05),
      0 6px 20px rgba(31, 25, 21, 0.06);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .rc:hover {
    transform: translateY(-2px);
    box-shadow:
      0 2px 4px rgba(31, 25, 21, 0.08),
      0 18px 32px rgba(31, 25, 21, 0.1);
  }
  .rc--photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .rc__poster {
    aspect-ratio: 3 / 4;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--ink);
  }
  .rc__poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .rc__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 42%, rgba(0,0,0,0.0) 0%, rgba(0,0,0,0.35) 70%),
      linear-gradient(180deg, rgba(31,25,21,0.15) 0%, rgba(31,25,21,0.55) 100%);
  }
  .rc__play {
    position: relative;
    z-index: 1;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    padding-left: 4px;
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.45);
  }
  .rc__dur {
    z-index: 1;
  }
  .rc__dur {
    position: absolute;
    bottom: 10px;
    right: 10px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(0, 0, 0, 0.35);
    padding: 3px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .rc__body {
    padding: 18px 20px 20px;
  }
  .rc__kind {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rc__body h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.22;
    margin: 8px 0 8px;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .muted {
    color: var(--ink-muted);
  }

  .rc--text {
    padding: 30px 28px 26px;
    position: relative;
  }
  .rc__q {
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.35;
    display: block;
    height: 42px;
    margin-top: -8px;
  }
  .rc--text blockquote {
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .rc--text figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .rc__name {
    color: var(--ink);
    font-weight: 500;
  }
  .rc__date {
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .rc__reply {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .rc__reply span {
    color: var(--accent);
  }
  .rv__footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 28px;
    margin-top: 12px;
  }

  @media (max-width: 960px) {
    .rv__wall {
      max-height: 1600px;
    }
    .rv__cols {
      columns: 2;
    }
  }
  @media (max-width: 520px) {
    .rv__wall {
      max-height: 1800px;
    }
    .rv__cols {
      columns: 1;
    }
  }
</style>
